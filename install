#!/usr/bin/env bash
# Put the tplay command on PATH. After this, type: tplay
set -euo pipefail
cd "$(dirname "$0")"

if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 is not installed." >&2
  exit 1
fi

if ! command -v pipx >/dev/null 2>&1; then
  echo "pipx is not installed. Install it, then run ./install again:" >&2
  echo "  sudo apt install pipx" >&2
  echo "  pipx ensurepath" >&2
  exit 1
fi

if ! command -v mpv >/dev/null 2>&1; then
  echo "mpv is not installed. Install it first, for example:" >&2
  echo "  sudo apt install mpv" >&2
  exit 1
fi

pipx install --force --editable .
echo
echo "Installed. Open the player from any terminal with:"
echo "  tplay"
