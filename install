#!/usr/bin/env bash
# One command: install anything missing, then open tplay.
# Linux and macOS. Windows uses install.ps1.
set -euo pipefail

export PATH="${HOME}/.local/bin:${PATH}"

os="$(uname -s)"
case "${os}" in
  MINGW*|MSYS*|CYGWIN*)
    echo "On Windows, open PowerShell and run:" >&2
    echo "  irm https://raw.githubusercontent.com/parthakk07/tplay/main/install.ps1 | iex" >&2
    exit 1
    ;;
  Darwin|Linux) ;;
  *)
    echo "This installer supports Linux, macOS, and Windows (PowerShell)." >&2
    exit 1
    ;;
esac

have() { command -v "$1" >/dev/null 2>&1; }

python_ok() {
  have python3 && python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)'
}

install_linux() {
  local missing=() pkgs=() cmd
  python_ok || missing+=(python3)
  have pipx || missing+=(pipx)
  have git || missing+=(git)
  ((${#missing[@]})) || return 0
  if have apt-get; then
    sudo apt-get update
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing[@]}"
  elif have dnf; then
    sudo dnf install -y "${missing[@]}"
  elif have pacman; then
    for cmd in "${missing[@]}"; do
      case "${cmd}" in
        pipx) pkgs+=(python-pipx) ;;
        python3) pkgs+=(python) ;;
        *) pkgs+=("${cmd}") ;;
      esac
    done
    sudo pacman -Sy --noconfirm "${pkgs[@]}"
  else
    echo "Install these first, then run this again: ${missing[*]}" >&2
    exit 1
  fi
}

install_mac() {
  local pkgs=()
  if ! have brew; then
    echo "Homebrew is required on Mac. Install it from https://brew.sh and run this again." >&2
    exit 1
  fi
  export PATH="$(brew --prefix)/bin:${HOME}/.local/bin:${PATH}"
  python_ok || pkgs+=(python)
  have pipx || pkgs+=(pipx)
  have git || pkgs+=(git)
  if ((${#pkgs[@]})); then
    brew install "${pkgs[@]}"
  fi
  export PATH="$(brew --prefix)/bin:${HOME}/.local/bin:${PATH}"
}

add_known_mpv_path() {
  local dir
  have mpv && return 0
  for dir in \
    /opt/homebrew/bin \
    /usr/local/bin \
    /snap/bin \
    "${HOME}/.local/bin" \
    "${HOME}/.nix-profile/bin" \
    /Applications/mpv.app/Contents/MacOS \
    "${HOME}/Applications/mpv.app/Contents/MacOS"
  do
    if [[ -x "${dir}/mpv" ]]; then
      export PATH="${dir}:${PATH}"
      return 0
    fi
  done
}

install_mpv() {
  add_known_mpv_path
  have mpv && return 0
  set +e
  if [[ "${os}" == "Darwin" ]]; then
    if have brew; then
      brew install mpv
    fi
  elif have apt-get; then
    sudo apt-get update
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y mpv
  elif have dnf; then
    sudo dnf install -y mpv
  elif have pacman; then
    sudo pacman -Sy --noconfirm mpv
  fi
  set -e
  add_known_mpv_path
  if ! have mpv; then
    echo "mpv is not installed. tplay will still open and show this command:" >&2
    if [[ "${os}" == "Darwin" ]]; then
      echo "  brew install mpv" >&2
    else
      echo "  sudo apt install mpv" >&2
    fi
  fi
}

case "${os}" in
  Darwin) install_mac ;;
  Linux) install_linux ;;
esac
install_mpv

if ! have tplay; then
  here=""
  src="${BASH_SOURCE[0]:-}"
  if [[ -n "${src}" && -f "${src}" ]]; then
    here="$(cd "$(dirname "${src}")" && pwd)"
  fi
  if [[ -n "${here}" && -f "${here}/pyproject.toml" ]]; then
    pipx install --force --editable "${here}"
  else
    pipx install --force "git+https://github.com/parthakk07/tplay.git"
  fi
  pipx ensurepath >/dev/null 2>&1 || true
  export PATH="${HOME}/.local/bin:${PATH}"
fi

if ! have tplay; then
  echo "tplay is installed. Open a new terminal and type: tplay" >&2
  exit 1
fi

exec tplay
